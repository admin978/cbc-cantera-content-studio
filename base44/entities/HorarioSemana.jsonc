    },
    "fecha_fin": {
      "type": "string",
      "format": "date",
      "title": "Fecha fin"
    },
    "etiqueta_fecha": {
      "type": "string",
      "title": "Etiqueta fecha"
    },
    "estado": {
      "type": "string",
      "title": "Estado",
      "enum": [
        "Borrador",
        "Publicado"
      ],
      "default": "Borrador"
    }
